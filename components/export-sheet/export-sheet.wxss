.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  background: #fff;
  border-top: 4rpx solid #333;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  text-align: center;
}

.opt {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  font-size: 26rpx;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
}

.box {
  border: 3rpx solid #333;
  background: #f5f5f5;
}

.cancel {
  text-align: center;
  margin-top: 16rpx;
  color: #555;
  font-size: 24rpx;
  border: 2rpx solid #bbb;
  display: inline-block;
  width: 100%;
  padding: 12rpx 0;
  border-radius: 8rpx;
}
