.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  background: #fff;
  border-top: 4rpx solid #333;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  max-height: 86vh;
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  text-align: center;
  flex-shrink: 0;
}

.sheet-scroll {
  max-height: 68vh;
}

.sec-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.custom-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.custom-input {
  flex: 1;
  border: 3rpx solid #999;
  background: #f5f5f5;
  padding: 10rpx 16rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.custom-unit {
  font-size: 22rpx;
  color: #666;
}

.meta {
  font-size: 22rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.note {
  font-size: 18rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.action-row .btn {
  flex: 1;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
}

.disabled {
  opacity: 0.5;
}

.opt {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  font-size: 26rpx;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
}

.box {
  border: 3rpx solid #333;
  background: #f5f5f5;
}

.cancel {
  text-align: center;
  margin-top: 8rpx;
  color: #555;
  font-size: 24rpx;
  border: 2rpx solid #bbb;
  padding: 12rpx 0;
  border-radius: 8rpx;
  flex-shrink: 0;
}
