.placeholder {
  background: #ddd;
  border: 3rpx solid #999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 24rpx;
  text-align: center;
  width: 100%;
  height: 100%;
}

.round {
  border-radius: 50%;
  overflow: hidden;
}

.sub {
  font-size: 20rpx;
  color: #888;
  margin-top: 4rpx;
}
