.spec-bar {
  background: #f5f5f5;
  border-bottom: 2rpx solid #ccc;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #999;
  background: #fff;
  color: #333;
  flex-shrink: 0;
}

.chip-sm {
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  border-radius: 20rpx;
}

.selected {
  background: #333;
  color: #fff;
  border-color: #333;
}

.fold {
  margin-left: auto;
  background: transparent;
  border: 2rpx solid #bbb;
  color: #555;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.spec-extra {
  background: #f5f5f5;
  padding: 0 20rpx 12rpx;
  font-size: 20rpx;
  color: #888;
}

.collapsed + .spec-extra {
  display: none;
}
