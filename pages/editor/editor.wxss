.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.ed-top {
  min-height: 88rpx;
  border-bottom: 3rpx solid #333;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  padding: 0 16rpx 12rpx;
  gap: 12rpx;
  flex-shrink: 0;
  font-size: 24rpx;
}

.spacer {
  flex: 1;
}

.btn-ghost.on {
  background: #333;
  color: #fff;
  border-color: #333;
}

.export-btn {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
}

.ed-canvas-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #ececec;
  min-height: 0;
  position: relative;
}

.ed-canvas {
  flex: 1;
  margin: 24rpx 40rpx;
  min-height: 240rpx;
  position: relative;
  display: flex;
}

.canvas-image {
  width: 100%;
  height: 100%;
  background: #ddd;
  border: 3rpx solid #999;
}

.compare-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.sec-chips {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-top: 2rpx solid #ddd;
  flex-shrink: 0;
  white-space: nowrap;
  width: 100%;
}

.bottom-sheet {
  background: #fff;
  border-top: 3rpx solid #333;
  padding: 20rpx 28rpx 16rpx;
  flex-shrink: 0;
  max-height: 420rpx;
  overflow-y: auto;
}

.sheet-title {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.filter-row,
.tpl-row {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.filter-thumb {
  display: inline-flex;
  flex-direction: column;
  width: 112rpx;
  margin-right: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: #555;
  vertical-align: top;
}

.ft {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 6rpx;
  border-radius: 8rpx;
}

.filter-thumb.selected .ft {
  border: 4rpx solid #333;
}

.ed-tools {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 0 12rpx;
}

.ed-tool {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #444;
  margin-bottom: 16rpx;
}

.ed-tool.active {
  color: #111;
  font-weight: 600;
}

.ed-tool-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
}

.ed-tool.active .ed-tool-icon {
  background: #333;
}

.tpl-item {
  display: inline-block;
  width: 128rpx;
  margin-right: 16rpx;
  vertical-align: top;
}

.ai-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.ai-card {
  width: calc(33.33% - 16rpx);
  margin: 8rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  border-radius: 12rpx;
}

.ai-card.active {
  background: #333;
  color: #fff;
}

.ai-note {
  margin-top: 16rpx;
  display: inline-block;
}

.ed-primary-bar {
  height: 96rpx;
  border-top: 3rpx solid #333;
  background: #f5f5f5;
  display: flex;
  flex-shrink: 0;
}

.ed-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #888;
  border-top: 4rpx solid transparent;
}

.ed-tab.selected {
  color: #222;
  font-weight: 700;
  border-top-color: #333;
}

.canvas-image.is-matte {
  background: #ececec;
}

.busy-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.matting-status {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.matting-btn {
  display: block;
  margin-bottom: 16rpx;
}

.bg-title {
  margin-top: 8rpx;
}

.bg-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hex-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-end;
  z-index: 110;
}

.hex-dialog {
  width: 100%;
  background: #fff;
  border-top: 4rpx solid #333;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.hex-input {
  border: 3rpx solid #999;
  background: #f5f5f5;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.hex-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  align-items: center;
}
