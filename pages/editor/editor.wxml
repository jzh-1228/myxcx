<view class="page">
  <view class="ed-top" style="padding-top: {{statusBarHeight}}px">
    <view class="btn-ghost" bindtap="onClose">← 关闭</view>
    <view class="btn-ghost {{comparing ? 'on' : ''}}" bindtap="onCompare">对比</view>
    <view class="spacer"></view>
    <view class="btn-ghost" bindtap="onUndo">撤销</view>
    <view class="btn-ghost" bindtap="onRedo">重做</view>
    <view class="btn export-btn" bindtap="onExport">导出</view>
  </view>

  <view class="ed-canvas-wrap">
    <spec-bar
      wx:if="{{specContext}}"
      spec-name="{{specContext.name}}"
      bg-color="{{specContext.bgColor}}"
      size-text="{{specContext.sizeText}}"
      collapsed="{{specCollapsed}}"
      bindtoggle="onToggleSpec"
      bindcolor="onSpecColor"
      bindkb="onSpecKb"
      bindaudit="onSpecAudit"
    />

    <view class="ed-canvas">
      <image wx:if="{{imagePath}}" class="canvas-image" src="{{imagePath}}" mode="aspectFit" />
      <placeholder-box
        wx:else
        text="预览图"
        sub="{{canvasHint}}"
        box-style="width:100%;height:100%;min-height:320rpx;"
      />
      <view wx:if="{{comparing}}" class="compare-mask">原图对比（桩）</view>
    </view>

    <scroll-view wx:if="{{mode === 'portrait'}}" class="sec-chips" scroll-x enable-flex>
      <view
        wx:for="{{portraitChips}}"
        wx:key="id"
        class="chip chip-sm {{portraitSub === item.id ? 'selected' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPortraitChip"
      >{{item.name}}</view>
    </scroll-view>
  </view>

  <view class="bottom-sheet">
    <block wx:if="{{mode === 'portrait'}}">
      <view class="sheet-title">{{portraitTitle}}</view>
      <slider-row
        wx:for="{{portraitSliders}}"
        wx:key="key"
        label="{{item.label}}"
        name="{{item.key}}"
        value="{{item.value}}"
        bindchange="onSliderChange"
      />
    </block>

    <block wx:elif="{{mode === 'filter'}}">
      <view class="sheet-title">滤镜</view>
      <scroll-view class="filter-row" scroll-x>
        <view
          wx:for="{{filters}}"
          wx:key="id"
          class="filter-thumb {{filterId === item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="onFilter"
        >
          <view class="ft placeholder">{{item.id === 'none' ? '原图' : item.name}}</view>
          <text>{{item.name}}</text>
        </view>
      </scroll-view>
      <slider-row
        label="强度"
        name="filterStrength"
        value="{{filterStrength}}"
        bindchange="onSliderChange"
      />
    </block>

    <block wx:elif="{{mode === 'edit'}}">
      <view class="sheet-title">{{editTool === 'adjust' ? '调节' : '编辑工具'}}</view>
      <view class="ed-tools">
        <view
          wx:for="{{editTools}}"
          wx:key="id"
          class="ed-tool {{editTool === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onEditTool"
        >
          <view class="ed-tool-icon box"></view>
          <text>{{item.name}}</text>
        </view>
      </view>
      <block wx:if="{{editTool === 'adjust'}}">
        <slider-row
          wx:for="{{adjustSliders}}"
          wx:key="key"
          label="{{item.label}}"
          name="{{item.key}}"
          value="{{item.value}}"
          bindchange="onSliderChange"
        />
      </block>
    </block>

    <block wx:elif="{{mode === 'create'}}">
      <view class="sheet-title">创作</view>
      <view class="ed-tools">
        <view
          wx:for="{{createTools}}"
          wx:key="id"
          class="ed-tool {{createTool === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onCreateTool"
        >
          <view class="ed-tool-icon box"></view>
          <text>{{item.name}}</text>
        </view>
      </view>
      <scroll-view wx:if="{{createTool === 'template'}}" class="tpl-row" scroll-x>
        <view
          wx:for="{{createTemplates}}"
          wx:key="id"
          class="tpl-item"
          data-id="{{item.id}}"
          bindtap="onCreateTemplate"
        >
          <placeholder-box text="{{item.name}}" box-style="width:128rpx;height:128rpx;border-radius:8rpx;" />
        </view>
      </scroll-view>
    </block>

    <block wx:elif="{{mode === 'ai'}}">
      <view class="sheet-title">AI 能力</view>
      <view class="ai-grid">
        <view
          wx:for="{{aiCaps}}"
          wx:key="id"
          class="ai-card box {{aiCap === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onAiCap"
        >{{item.name}}</view>
      </view>
      <view class="note-tag ai-note">能力入口，不绑定具体厂商</view>
    </block>
  </view>

  <view class="ed-primary-bar safe-bottom">
    <view
      wx:for="{{modes}}"
      wx:key="id"
      class="ed-tab {{mode === item.id ? 'selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="onMode"
    >{{item.name}}</view>
  </view>

  <export-sheet
    show="{{showExport}}"
    bindclose="onCloseExport"
    bindsave="onExportSave"
    bindhd="onExportHd"
    bindshare="onExportShare"
    bindsaveid="onExportSaveId"
  />
</view>
