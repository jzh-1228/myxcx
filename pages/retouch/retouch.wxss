.page {
  padding-bottom: 24rpx;
}

.cta-row {
  display: flex;
  gap: 20rpx;
  padding: 32rpx;
}

.cta-big {
  flex: 1;
  height: 176rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 26rpx;
}

.cta-icon {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #333;
  border-radius: 50%;
  background: #fff;
}

.draft-scroll {
  width: 100%;
  white-space: nowrap;
}

.draft-card {
  display: inline-flex;
  flex-direction: column;
  width: 144rpx;
  margin-right: 16rpx;
  vertical-align: top;
}

.draft-thumb {
  width: 144rpx;
  height: 144rpx;
  background: #ddd;
  border: 3rpx solid #999;
  margin-bottom: 8rpx;
}

.draft-card .label-sm {
  margin-top: 8rpx;
}

.draft-more {
  width: 144rpx;
  height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #aaa;
}

.tools-grid {
  display: flex;
  flex-wrap: wrap;
}

.tool-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #444;
  margin-bottom: 16rpx;
}

.tool-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #666;
}

.banner {
  padding: 24rpx;
  text-align: center;
  font-size: 20rpx;
  color: #888;
}
