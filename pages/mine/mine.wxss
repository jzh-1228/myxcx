.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 0 16rpx;
}

.nickname {
  font-weight: 700;
  font-size: 30rpx;
}

.vip-banner {
  padding: 32rpx;
  margin: 24rpx 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vip-title {
  font-weight: 600;
  font-size: 26rpx;
}

.mine-row {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 2rpx solid #eee;
  font-size: 26rpx;
  gap: 20rpx;
}

.mine-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
}

.mine-arrow {
  margin-left: auto;
  color: #bbb;
  font-size: 28rpx;
}
