<view class="page">
  <view class="section">
    <view class="profile-head">
      <placeholder-box text="头像" round box-style="width:104rpx;height:104rpx;" />
      <view>
        <view class="nickname">用户昵称</view>
        <view class="label-sm">ID: 10086</view>
      </view>
    </view>

    <view class="vip-banner box">
      <view>
        <view class="vip-title">会员 / 次数</view>
        <view class="label-sm">剩余 AI 次数 · 会员权益</view>
      </view>
      <view class="btn" bindtap="onVip">开通</view>
    </view>

    <view class="mine-row" bindtap="onWorks">
      <view class="mine-icon box"></view>
      <text>作品</text>
      <text class="mine-arrow">›</text>
    </view>
    <view class="mine-row" bindtap="onDrafts">
      <view class="mine-icon box"></view>
      <text>草稿</text>
      <text class="mine-arrow">›</text>
    </view>
    <view class="mine-row" bindtap="onSettings">
      <view class="mine-icon box"></view>
      <text>设置</text>
      <text class="mine-arrow">›</text>
    </view>
    <view class="mine-row" bindtap="onPrivacy">
      <view class="mine-icon box"></view>
      <text>隐私</text>
      <text class="mine-arrow">›</text>
    </view>
  </view>
</view>
