.page {
  padding: 32rpx;
}

.empty {
  padding: 80rpx 0;
  display: flex;
  justify-content: center;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.card {
  width: calc(33.33% - 16rpx);
  margin: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.thumb {
  width: 100%;
  height: 220rpx;
  background: #ddd;
  border: 3rpx solid #999;
}
