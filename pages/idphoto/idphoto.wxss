.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border: 3rpx solid #999;
  background: #f5f5f5;
  border-radius: 40rpx;
  margin-bottom: 24rpx;
}

.search-icon {
  font-size: 24rpx;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: #222;
  height: 44rpx;
}

.spec-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.spec-card {
  width: calc(33.33% - 16rpx);
  margin: 8rpx;
  height: 144rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 12rpx;
}

.spec-name {
  font-size: 22rpx;
}

.sc-size {
  font-size: 18rpx;
  color: #888;
}

.empty {
  text-align: center;
  padding: 32rpx 0;
}

.hint {
  display: block;
  text-align: center;
  padding: 16rpx;
  margin-top: 24rpx;
}
