<view class="page">
  <view class="app-header">
    <view class="app-name">创作</view>
    <view class="app-sub">AI 写真 · 模板 · 风格</view>
  </view>

  <view class="section">
    <view class="section-title">AI 创作</view>
    <view class="card-grid">
      <view
        wx:for="{{features}}"
        wx:key="id"
        class="feat-card box"
        data-id="{{item.id}}"
        bindtap="onFeature"
      >
        <text class="feat-name">{{item.name}}</text>
        <text class="fc-sub">{{item.sub}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">热门模板</view>
    <scroll-view scroll-x class="tpl-scroll">
      <view
        wx:for="{{templates}}"
        wx:key="id"
        class="tpl-card"
        data-id="{{item.id}}"
        bindtap="onTemplate"
      >
        <placeholder-box text="{{item.name}}" box-style="width:200rpx;height:260rpx;border-radius:12rpx;" />
      </view>
    </scroll-view>
  </view>
</view>
