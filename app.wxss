page {
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  color: #222;
  background: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
}

view,
text,
image,
button,
input,
scroll-view {
  box-sizing: border-box;
}

.box {
  border: 3rpx solid #333;
  background: #f5f5f5;
}

.box-dashed {
  border: 3rpx dashed #999;
  background: #fafafa;
}

.placeholder {
  background: #ddd;
  border: 3rpx solid #999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 24rpx;
  text-align: center;
}

.btn {
  border: 3rpx solid #333;
  background: #fff;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  text-align: center;
  color: #222;
  line-height: 1.2;
}

.btn-primary {
  background: #333;
  color: #fff;
}

.btn-ghost {
  background: transparent;
  border: 2rpx solid #bbb;
  color: #555;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  line-height: 1.2;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #999;
  background: #fff;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  border-radius: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.chip.selected,
.chip-selected {
  background: #333;
  color: #fff;
  border-color: #333;
}

.chip-sm {
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  border-radius: 20rpx;
}

.label {
  font-size: 24rpx;
  color: #444;
}

.label-sm {
  font-size: 20rpx;
  color: #888;
}

.app-header {
  padding: 24rpx 32rpx 16rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.app-sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.section {
  padding: 16rpx 32rpx 24rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.note-tag {
  font-size: 18rpx;
  color: #888;
  border: 2rpx dashed #bbb;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.h-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
